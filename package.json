{
  "name": "pdf-editor",
  "version": "1.0.0",
  "main": "electron/main.js",
  "scripts": {
    "start": "concurrently -k \"npm run dev\" \"npm run electron:wait\"",
    "dev": "vite",
    "build": "vite build",
    "electron": "electron .",
    "electron:wait": "wait-on tcp:5173 && cross-env ELECTRON_START_URL=http://localhost:5173 electron ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Local PDF Editor",
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-pdf": "^9.0.0",
    "@pdf-lib/fontkit": "^1.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.1.0",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  }
}
